<Window x:Class="StudentTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Student Tracker — Login"
        Height="520"
        Width="440"
        MinHeight="480"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#004B5A"/>
        <SolidColorBrush x:Key="BrandHoverBrush" Color="#003D4A"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#C5D0D4"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5A6B70"/>

        <Style x:Key="FieldBoxStyle" TargetType="Control">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0"
              Background="#EEF2F3"
              Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Exit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- Logo + title + form (matches whiteboard layout) -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="320"
                    Margin="24,8">

            <Image Source="/Assets/logo.png"
                   Height="52"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18"/>

            <TextBlock Text="Student Tracker"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrandBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>

            <!-- Username: label left, field right -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Username"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{StaticResource BrandBrush}"/>
                <TextBox x:Name="UsernameBox"
                         Grid.Column="1"
                         Style="{StaticResource FieldBoxStyle}"
                         VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Password: label left, field right -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Password"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{StaticResource BrandBrush}"/>
                <PasswordBox x:Name="PasswordBox"
                             Grid.Column="1"
                             Style="{StaticResource FieldBoxStyle}"
                             VerticalContentAlignment="Center"/>
            </Grid>

            <Button Content="Login"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="LoginButton_Click"/>
        </StackPanel>

        <!-- Bottom: Sign Up (left) | Back (right) -->
        <Grid Grid.Row="2" Margin="20,0,20,18">
            <Button Content="Sign Up"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="SignUpButton_Click"/>
            <Button Content="Back"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="BackButton_Click"/>
        </Grid>
    </Grid>
</Window>
