<Window x:Class="StudentTracker.StudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Varsity Student Management System"
        Height="760" Width="1020" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#ECECEC" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="ShellBrush" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="ActiveNavBrush" Color="#7A1F1F"/>
        <SolidColorBrush x:Key="PrimaryActionBrush" Color="#3A2A22"/>
        <SolidColorBrush x:Key="EditActionBrush" Color="#6B4C3B"/>
        <SolidColorBrush x:Key="DeleteActionBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="SecondaryActionBrush" Color="#D9D9D9"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ActiveNavBrush}"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SecondaryActionBrush}"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="FormFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource ShellBrush}">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#F4C430" CornerRadius="3" Margin="0,0,10,0">
                        <TextBlock Text="V" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VARSITY STUDENT MANAGEMENT SYSTEM" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Welcome, Admin" Foreground="White" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DateTimeText" Foreground="#D0D0D0" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource ShellBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <Button Content="Dashboard" Style="{StaticResource NavButtonStyle}" Click="DashboardButton_Click"/>
                    <Button Content="Students" Style="{StaticResource ActiveNavButtonStyle}" Click="StudentsButton_Click"/>
                    <Button Content="Courses" Style="{StaticResource NavButtonStyle}" Click="CoursesButton_Click"/>
                    <Button Content="Registration" Style="{StaticResource NavButtonStyle}" Click="RegistrationButton_Click"/>
                    <Button Content="Reports" Style="{StaticResource NavButtonStyle}" Click="ReportsButton_Click"/>
                    <Button Content="Settings" Style="{StaticResource NavButtonStyle}" Click="SettingsButton_Click"/>
                </StackPanel>
                <Button Content="Logout" DockPanel.Dock="Bottom" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,12" Click="LogoutButton_Click"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
                <TextBlock Text="Student management"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#555555" Margin="0,0,0,14"/>

                <!-- Data table -->
                <DataGrid x:Name="StudentsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#DDDDDD"
                          BorderBrush="#C8C8C8"
                          BorderThickness="1"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#EAF2F8"
                          ColumnHeaderHeight="34"
                          RowHeight="32"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          Margin="0,0,0,14"
                          Height="160"
                          SelectionChanged="StudentsGrid_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#5D6D7E"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#4A5866"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Student no." Binding="{Binding StudentNumber}" Width="100"/>
                        <DataGridTextColumn Header="First name" Binding="{Binding FirstName}" Width="*"/>
                        <DataGridTextColumn Header="Last name" Binding="{Binding LastName}" Width="*"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="80"/>
                        <DataGridTextColumn Header="Qualification" Binding="{Binding Qualification}" Width="*"/>
                        <DataGridTextColumn Header="Campus" Binding="{Binding Campus}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="New student"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource PrimaryActionBrush}"
                            Click="NewStudentButton_Click"/>
                    <Button Content="Edit"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource EditActionBrush}"
                            Click="EditButton_Click"/>
                    <Button Content="Delete"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource DeleteActionBrush}"
                            Click="DeleteButton_Click"/>
                    <TextBox x:Name="SearchBox"
                             Width="140" Height="34"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             Margin="0,0,8,0"
                             BorderBrush="#C8C8C8"/>
                    <Button Content="Search"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Click="SearchButton_Click"/>
                    <Button Content="Refresh"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Click="RefreshButton_Click"/>
                    <Button Content="Back"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Click="BackButton_Click"/>
                </StackPanel>

                <!-- Student details form -->
                <Border Background="#F7F7F7" BorderBrush="#D0D0D0" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left column -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Student number" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="StudentNumberBox" Style="{StaticResource FormFieldStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Last name" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="LastNameBox" Style="{StaticResource FormFieldStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Qualification" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="QualificationBox" Style="{StaticResource FormFieldStyle}"/>
                        </StackPanel>

                        <!-- Right column -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="First name" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="FirstNameBox" Style="{StaticResource FormFieldStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Gender" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="GenderBox" Style="{StaticResource FormFieldStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Campus" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="CampusBox" Style="{StaticResource FormFieldStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Form buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Save"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource EditActionBrush}"
                            Click="SaveButton_Click"/>
                    <Button Content="Cancel"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
