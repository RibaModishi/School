<Window x:Class="StudentTracker.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Varsity Student Management System"
        Height="620"
        Width="980"
        MinHeight="520"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#ECECEC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="ShellBrush" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="ActiveNavBrush" Color="#7A1F1F"/>
        <SolidColorBrush x:Key="CardBrush" Color="#F7F7F7"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ActiveNavBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource ShellBrush}">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#F4C430" CornerRadius="3" Margin="0,0,10,0">
                        <TextBlock Text="V" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VARSITY STUDENT MANAGEMENT SYSTEM"
                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Welcome, Admin" Foreground="White" FontSize="12"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DateTimeText"
                               Foreground="#D0D0D0" FontSize="11"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource ShellBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <Button Content="Dashboard" Style="{StaticResource ActiveNavButtonStyle}"
                            Click="DashboardButton_Click"/>
                    <Button Content="Students" Style="{StaticResource NavButtonStyle}"
                            Click="StudentsButton_Click"/>
                    <Button Content="Courses" Style="{StaticResource NavButtonStyle}"
                            Click="CoursesButton_Click"/>
                    <Button Content="Registration" Style="{StaticResource NavButtonStyle}"
                            Click="RegistrationButton_Click"/>
                    <Button Content="Reports" Style="{StaticResource NavButtonStyle}"
                            Click="ReportsButton_Click"/>
                    <Button Content="Settings" Style="{StaticResource NavButtonStyle}"
                            Click="SettingsButton_Click"/>
                </StackPanel>

                <Button Content="Logout" DockPanel.Dock="Bottom"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,0,0,12"
                        Click="LogoutButton_Click"/>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,28">
                <TextBlock Text="Dashboard overview"
                           FontSize="22" Foreground="#666666"
                           Margin="0,0,0,18"/>

                <!-- Stats row -->
                <UniformGrid Columns="4" Margin="0,0,0,24">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="#D8D8D8"
                            BorderThickness="1" Margin="0,0,12,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="245" FontSize="28" FontWeight="Bold" Foreground="#333333"/>
                            <TextBlock Text="Total students" FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="#D8D8D8"
                            BorderThickness="1" Margin="0,0,12,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="12" FontSize="28" FontWeight="Bold" Foreground="#333333"/>
                            <TextBlock Text="Courses" FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="#D8D8D8"
                            BorderThickness="1" Margin="0,0,12,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="150" FontSize="28" FontWeight="Bold" Foreground="#333333"/>
                            <TextBlock Text="Registrations" FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="#D8D8D8"
                            BorderThickness="1" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="18" FontSize="28" FontWeight="Bold" Foreground="#333333"/>
                            <TextBlock Text="Lecturers" FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Recent activity -->
                <TextBlock Text="Recent activity" FontSize="16" Foreground="#555555" Margin="0,0,0,10"/>
                <Border Background="{StaticResource CardBrush}" BorderBrush="#D8D8D8"
                        BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="John registered." FontSize="14" Foreground="#444444" Margin="0,0,0,10"/>
                        <Separator Background="#DDDDDD" Margin="0,0,0,10"/>
                        <TextBlock Text="Mary updated." FontSize="14" Foreground="#444444" Margin="0,0,0,10"/>
                        <Separator Background="#DDDDDD" Margin="0,0,0,10"/>
                        <TextBlock Text="Peter deleted." FontSize="14" Foreground="#444444"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
