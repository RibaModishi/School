<Window x:Class="Campus_Connect_Startup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign Up — Campus Connect"
        Height="640"
        Width="980"
        MinHeight="560"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FormBackground}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*"/>
            <ColumnDefinition Width="1.55*"/>
        </Grid.ColumnDefinitions>

        <!-- Branding sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrandGreen}" ClipToBounds="True">
            <Grid>
                <Canvas IsHitTestVisible="False">
                    <Ellipse Width="340" Height="340" Fill="#2D6A4F" Opacity="0.35"
                             Canvas.Left="-120" Canvas.Top="-80"/>
                    <Ellipse Width="280" Height="280" Fill="#40916C" Opacity="0.22"
                             Canvas.Left="40" Canvas.Top="120"/>
                    <Ellipse Width="220" Height="220" Fill="#FFFFFF" Opacity="0.06"
                             Canvas.Left="-40" Canvas.Top="380"/>
                    <Ellipse Width="160" Height="160" Fill="#52B788" Opacity="0.18"
                             Canvas.Left="180" Canvas.Top="40"/>
                </Canvas>

                <DockPanel Margin="36,40,36,40">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="{StaticResource BrandOrange}"
                                VerticalAlignment="Center">
                            <TextBlock Text="C"
                                       FontFamily="Georgia"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0"/>
                        </Border>
                        <TextBlock Text="Campus Connect"
                                   Margin="12,0,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" Margin="0,48,0,0">
                        <TextBlock Text="Join your campus,&#x0a;one login at a time."
                                   FontFamily="Georgia"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   LineHeight="40"/>
                        <TextBlock Text="Register once, verify your email, and get access to student services, courses, and updates in one place."
                                   Margin="0,20,0,0"
                                   FontSize="13"
                                   Foreground="#C8D5CE"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Registration form -->
        <Border Grid.Column="1" Background="{StaticResource FormBackground}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0">
                <StackPanel MaxWidth="440"
                            Margin="56,48,56,40"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">

                    <TextBlock Text="Create your account"
                               FontFamily="Georgia"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource BodyText}"/>
                    <TextBlock Text="Step 1 of 1 — takes less than a minute"
                               Margin="0,8,0,28"
                               FontSize="13"
                               Foreground="{StaticResource MutedText}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="FULL NAME"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox x:Name="FullNameBox"
                                 Style="{StaticResource RoundedTextBox}"
                                 TabIndex="0"
                                 TextChanged="FullNameBox_TextChanged"/>
                        <TextBlock x:Name="FullNamePlaceholder"
                                   Text="Jane Student"
                                   IsHitTestVisible="False"
                                   Foreground="#A8A29E"
                                   FontSize="14"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL ADDRESS"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox x:Name="EmailBox"
                                 Style="{StaticResource RoundedTextBox}"
                                 TabIndex="1"
                                 TextChanged="EmailBox_TextChanged"/>
                        <TextBlock x:Name="EmailPlaceholder"
                                   Text="you@campus.edu"
                                   IsHitTestVisible="False"
                                   Foreground="#A8A29E"
                                   FontSize="14"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="PASSWORD"/>
                            <Grid>
                                <PasswordBox x:Name="PasswordBox"
                                             Style="{StaticResource RoundedPasswordBox}"
                                             TabIndex="2"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                                <TextBlock x:Name="PasswordPlaceholder"
                                           Text="••••••••"
                                           IsHitTestVisible="False"
                                           Foreground="#A8A29E"
                                           FontSize="14"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIRM"/>
                            <Grid>
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Style="{StaticResource RoundedPasswordBox}"
                                             TabIndex="3"
                                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                                <TextBlock x:Name="ConfirmPlaceholder"
                                           Text="••••••••"
                                           IsHitTestVisible="False"
                                           Foreground="#A8A29E"
                                           FontSize="14"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource InfoFill}"
                            BorderBrush="{StaticResource InfoBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="0,0,0,20">
                        <TextBlock Text="We'll send a confirmation link to your email — click it to activate your account before signing in."
                                   FontSize="12"
                                   Foreground="#9A3412"
                                   TextWrapping="Wrap"
                                   LineHeight="18"/>
                    </Border>

                    <TextBlock x:Name="ErrorText"
                               Visibility="Collapsed"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button x:Name="CreateAccountButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="CREATE MY ACCOUNT"
                            TabIndex="4"
                            IsDefault="True"
                            Click="CreateAccountButton_Click"/>

                    <Button x:Name="ResendButton"
                            Margin="0,10,0,0"
                            Height="40"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="{StaticResource BrandOrange}"
                            BorderThickness="1"
                            Foreground="{StaticResource BrandOrange}"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Content="RESEND CONFIRMATION EMAIL"
                            TabIndex="5"
                            Click="ResendButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFF4EB"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="StatusText"
                               Visibility="Collapsed"
                               Margin="0,14,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <TextBlock Margin="0,18,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedText}"
                               HorizontalAlignment="Center">
                        <Run Text="Already registered? "/>
                        <Hyperlink NavigateUri="signin"
                                   RequestNavigate="SignInLink_RequestNavigate"
                                   Foreground="{StaticResource BrandOrange}"
                                   FontWeight="SemiBold"
                                   TextDecorations="None">
                            Sign in
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
